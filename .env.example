# Copiez ce fichier en « .env » (cp .env.example .env) puis remplissez-le.
# Ne partagez jamais .env : il contient votre clé VPN.

# Clé privée WireGuard Proton VPN.
# Sur account.protonvpn.com > Téléchargements > WireGuard : plateforme « GNU/Linux »,
# cochez « NAT-PMP (redirection de port) », choisissez un serveur « P2P »,
# créez le fichier et copiez la ligne « PrivateKey = ... » (la valeur seulement).
WIREGUARD_PRIVATE_KEY=

# Pays des serveurs Proton (noms en anglais, séparés par des virgules).
SERVER_COUNTRIES=Switzerland

# Dossier des données : DATA_DIR/torrents (téléchargements) et DATA_DIR/library
# (films dans movies/, séries dans tv/). Un seul dossier, sur un seul volume,
# pour que les hardlinks marchent (pas d'espace disque en double).
DATA_DIR=/volume1/media

# Dossier des réglages des applications (petit, à sauvegarder).
CONFIG_DIR=/volume1/docker/media-stack

# Utilisateur propriétaire des fichiers. Obtenez-les avec la commande « id »
# connecté en tant que l'utilisateur du NAS qui possède DATA_DIR.
PUID=1000
PGID=1000

# Fuseau horaire (liste : en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=Europe/Paris

# Port de l'interface qBittorrent sur le NAS (facultatif, 8081 par défaut).
# QBIT_PORT=8081
